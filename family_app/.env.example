# انسخ هذا الملف باسم .env وعبّي القيم الحقيقية (لا ترفعه لـ GitHub)

# مفتاح سري عشوائي لتشفير الجلسة - غيّره لأي نص طويل عشوائي
SECRET_KEY=change-me-to-a-long-random-string

# كلمة السر المشتركة بينك وبين ملاك للدخول للتطبيق
APP_PASSCODE=1234

# رابط قاعدة بيانات Supabase (من إعدادات المشروع فيه: Connection string -> URI)
# شكله: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=

# مفتاح Gemini API من https://aistudio.google.com/app/apikey (اختياري - بدونه يشتغل الاقتراح اليدوي بس)
GEMINI_API_KEY=
